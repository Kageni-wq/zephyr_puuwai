/* Build coverage only: these pins are not a simultaneous board wiring profile. */
&pinctrl {
	test_pwm: test-pwm {
		group0 { pinmux = <PIN_P0_2__UT1_T0_A>; };
	};
	test_qdec: test-qdec {
		group0 { pinmux = <PIN_P0_4__UT2_T0_A>, <PIN_P0_5__UT2_T1_A>; };
	};
};
&adc0 { status = "okay"; };
&dac0 { status = "okay"; };
&cmp0 { status = "okay"; };
&gpio14 { status = "okay"; };
&i2c0 { status = "okay"; };
&lpi2c0 { status = "okay"; };
&spi0 { status = "okay"; };
&i2s0 { status = "okay"; };
&dma0 { status = "okay"; };
&evtrtr0 { status = "okay"; };
&rtc0 { status = "okay"; };
&timer0 { status = "okay"; };
&crc0 { status = "okay"; };
&rng { status = "okay"; };
&wdog0 { status = "okay"; };
&can0 { status = "okay"; };
&utimer0 {
	status = "okay";
	counter { status = "okay"; };
};
&utimer1 {
	status = "okay";
	pwm1 {
		status = "okay";
		pinctrl-0 = <&test_pwm>;
		pinctrl-names = "default";
	};
};
&utimer2 {
	status = "okay";
	qdec {
		status = "okay";
		pinctrl-0 = <&test_qdec>;
		pinctrl-names = "default";
	};
};
