# Alif Camera controller driver configuration options

# Copyright (C) 2024 Alif Semiconductor
# SPDX-License-Identifier: Apache-2.0

config VIDEO_ALIF_CAM
	bool "Camera Parallel Interface (CPI) controller driver"
	default y
	depends on DT_HAS_ALIF_CAM_ENABLED

if VIDEO_ALIF_CAM

config VIDEO_ALIF_CAM_INIT_PRIORITY
	int "CPI Video initialization priority"
	default 59
	help
	 System initialization priority for Alif Camera Driver.
	 The default initialization priority for video devices is 60.

config VIDEO_ALIF_CAM_EXTENDED
	bool "CPI has extended registers and Ports."
	help
	 CPI has extended registers and ports to forward video
	 signals to ISP and dump the frame to memory.

endif #VIDEO_ALIF_CAM

config VIDEO_HM0360_ALIF
	bool "Alif HM0360 camera support"
	default y
	depends on ALIF_VENDOR && DT_HAS_HIMAX_HM0360_ALIF_ENABLED
	select I2C

config VIDEO_MT9M114_ALIF
	bool "Alif MT9M114 camera support"
	default y
	depends on ALIF_VENDOR && DT_HAS_APTINA_MT9M114_ALIF_ENABLED
	select I2C

config MT9M114_ALIF_PARALLEL_INIT
	bool "MT9M114 parallel interface initialization"
	depends on VIDEO_MT9M114_ALIF
	default y
